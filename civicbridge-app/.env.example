# Copy this file to .env.local for local development.
# The key is used ONLY by server-side API routes; it is never exposed to the browser.

# Civic Sathi: separate Gnani speech keys and Gemini reasoning key.
GNANI_STT_API_KEY=
GNANI_TTS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Hosted rate limiting requires a private Supabase server key.
SUPABASE_URL=
SUPABASE_KEY=

# Required for live AI mode. Without it, CivicBridge runs in deterministic fallback mode.
OPENAI_API_KEY=

# Optional. Defaults to openrouter/stealth/ox-alpha when unset.
OPENAI_MODEL=

# Optional. Set this only if your key targets an OpenRouter-compatible gateway
# instead of api.openai.com, e.g.:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_BASE_URL=

